{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PingWatch": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=pingwatch.db"
  },
  "JwtSettings": {
    "SecretKey": "PingWatch-Super-Secret-Key-2026-ChangeInProduction-AtLeast32Chars!",
    "Issuer": "PingWatch",
    "Audience": "PingWatchUsers",
    "ExpiryMinutes": 480
  },
  "PingSettings": {
    "IntervalMs": 10000,
    "TimeoutMs": 1500
  }
}
